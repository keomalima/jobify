# Local PostgreSQL credentials match docker-compose.yml.
DATABASE_URL="postgresql://user:password@localhost:5432/app_db"

# Dedicated disposable database: tests delete its records.
DATABASE_URL_TEST="postgresql://user:password@localhost:5432/app_db_test"

# Replace with a random secret before starting the backend.
# Generate one: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""
